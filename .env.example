# Copy to .env.local and fill from Supabase Dashboard → Settings → API
# Must be …supabase.co — NOT your Vercel/site URL (wrong URL → "not valid JSON" errors).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Site URL for auth emails (password reset). Local only; on Vercel Production use https://zibidi.vercel.app
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Authentication → URL Configuration (local):
# Site URL: http://localhost:3000
# Redirect URLs:
#   http://localhost:3000/auth/callback
#   http://localhost:3000/auth/reset-password
